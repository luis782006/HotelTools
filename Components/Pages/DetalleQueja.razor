@page "/queja/{IdQueja}"
@attribute [Authorize(Policy = "ViewQuejas")]
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components
@using HotelTools.Services
@inject NavigationManager NavigationManager
@inject HotelContext Context
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<ValidaPermiso PermisoRequerido="ViewQuejas" Objeto="DetalleQueja" />

<MudContainer MaxWidth="MaxWidth.False">
    @if (Cargando)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-8">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </MudStack>
    }
    else if (queja == null)
    {
        <MudAlert Severity="Severity.Error">Queja no encontrada.</MudAlert>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudPaper Elevation="4" Class="pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" Size="Size.Small" OnClick="VolverALista" />
                            <MudText Typo="Typo.h5">Queja - Habitación @habitacionInfo</MudText>
                        </MudStack>
                        <MudChip T="string" Size="Size.Medium" Variant="Variant.Filled"
                                  Style="@GetEstadoStyle(EstadoDisplay())">
                            @(EstadoDisplay())
                        </MudChip>
                    </MudStack>

                    <MudDivider Class="my-2" />

                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Título</MudText>
                            <MudText>@queja.Quejas</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Huésped</MudText>
                            <MudText>@huespedNombre</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Prioridad</MudText>
                            <MudChip T="string" Size="Size.Small" Style="@($"background: {prioridadActual?.Color ?? "#888"}; color: #fff;")">
                                @(GetNombrePrioridad(prioridadActual?.NombrePrioridad ?? 0))
                            </MudChip>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Depto Receptor</MudText>
                            <MudText>@deptoReceptor</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Depto Ejecutor</MudText>
                            <MudText>@deptoEjecutor</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Empleado Asignado</MudText>
                            <MudText>@(empleadoAsignado ?? "Sin asignar")</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Elevation="4" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-4">Acciones</MudText>
                    <MudStack Spacing="2">
                        @if (PuedeAsignar())
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Info" FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AbrirAsignar">
                                Asignar / Reasignar
                            </MudButton>
                        }
                        @if (PuedeCambiarEstado())
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="AbrirCambiarEstado">
                                Cambiar Estado
                            </MudButton>
                        }
                        @if (PuedeAprobarCompra())
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.ShoppingCart" OnClick="AbrirAprobarCompra">
                                Aprobar/Rechazar Compra
                            </MudButton>
                        }
                        @if (PuedeCerrar())
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="AbrirCerrar">
                                Cerrar Queja
                            </MudButton>
                        }
                        @if (PuedeReabrir())
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.Replay" OnClick="AbrirReabrir">
                                Reabrir Queja
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.History" OnClick="AbrirHistorial">
                            Ver Historial
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Elevation="4" Class="pa-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
                        <MudText Typo="Typo.h6">Historial de Cambios</MudText>
                        @if (historial.Any())
                        {
                            <MudTooltip Text="@(ordenAscendente ? "Ordenar descendente" : "Ordenar ascendente")">
                                <MudIconButton Icon="@Icons.Material.Filled.SwapVert" Size="Size.Small"
                                               OnClick="ToggleOrdenHistorial" Color="Color.Default" />
                            </MudTooltip>
                        }
                    </MudStack>
                    @if (historial.Any())
                    {
                        <MudTimeline>
                            @foreach (var h in ordenAscendente
                                ? historial.OrderBy(h => h.FechaRegistro)
                                : historial.OrderByDescending(h => h.FechaRegistro))
                            {
                                <MudTimelineItem>
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body2" Color="Color.Primary">
                                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />@GetEmpleadoNombre(h.ID_Empleado)
                                        </MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="mr-1" />@h.FechaRegistro.ToString("dd/MM/yyyy HH:mm") - @GetNombreEstado(h.ID_Estado)
                                        </MudText>
                                        @if (!string.IsNullOrWhiteSpace(h.observaciones))
                                        {
                                            <MudText Typo="Typo.body1">
                                                <MudIcon Icon="@Icons.Material.Filled.Notes" Size="Size.Small" Class="mr-1" />@h.observaciones
                                            </MudText>
                                        }
                                    </MudStack>
                                </MudTimelineItem>
                            }
                        </MudTimeline>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Sin registros de historial.</MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter] public string IdQueja { get; set; }

    private bool Cargando = true;
    private Queja? queja;
    private List<HistorialQueja> historial = new();
    private Dictionary<decimal, string> empleadosHistorial = new();
    private bool ordenAscendente = false;
    private EstadoQueja? estadoActual;
    private PrioridadQueja? prioridadActual;
    private string huespedNombre = "";
    private string deptoReceptor = "";
    private string deptoEjecutor = "";
    private string? empleadoAsignado;
    private List<EstadoQueja> lstEstados = new();
    private string habitacionInfo = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarDatos();
            Cargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarDatos()
    {
        lstEstados = await Context.EstadosQueja.AsNoTracking().ToListAsync();

        if (decimal.TryParse(IdQueja, out var id))
        {
            queja = await Context.Quejas.FindAsync(id);
            if (queja != null)
            {
                estadoActual = lstEstados.FirstOrDefault(e => e.ID_Estado == queja.ID_Estado);
                prioridadActual = await Context.PrioridadesQueja.FindAsync(queja.ID_Prioridad);

                var huesped = await Context.Huespedes.FindAsync(queja.ID_Huesped);
                huespedNombre = huesped != null ? $"{huesped.Nombre?.Trim()} {huesped.Apellido?.Trim()}" : "";

                var dr = await Context.Departamentos.FindAsync(queja.ID_DepartamentoRecibe);
                deptoReceptor = dr?.NombreDepartamento ?? "";

                var de = await Context.Departamentos.FindAsync(queja.ID_DepartamentoEjecuta);
                deptoEjecutor = de?.NombreDepartamento ?? "";

                if (queja.ID_EmpleadoAsignacion.HasValue)
                {
                    var emp = await Context.Empleados.FindAsync(queja.ID_EmpleadoAsignacion.Value);
                    empleadoAsignado = emp != null ? $"{emp.Nombre?.Trim()} {emp.Apellido?.Trim()}" : null;
                }

                historial = await Context.HistorialQuejas
                    .Where(h => h.ID_Quejas == queja.ID_Quejas)
                    .ToListAsync();

                foreach (var h in historial)
                {
                    if (!empleadosHistorial.ContainsKey(h.ID_Empleado))
                    {
                        var emp = await Context.Empleados.FindAsync(h.ID_Empleado);
                        empleadosHistorial[h.ID_Empleado] = emp != null
                            ? $"{emp.Nombre?.Trim()} {emp.Apellido?.Trim()}"
                            : "N/D";
                    }
                }

                var hab = await Context.Habitaciones.FindAsync(queja.ID_Habitaciones);
                habitacionInfo = hab != null ? $"{hab.DescripcionHab} ({hab.ID_NroHab})" : "N/D";
            }
        }
    }

    private void VolverALista() => NavigationManager.NavigateTo("/listaquejas");

    private bool PuedeAsignar() => queja?.ID_EmpleadoAsignacion == null
        && (queja?.ID_Estado == lstEstados.FirstOrDefault(e => e.NombreEstado == "Nuevo")?.ID_Estado
            || queja?.ID_Estado == lstEstados.FirstOrDefault(e => e.NombreEstado == "Asignado")?.ID_Estado);

    private string EstadoDisplay()
    {
        if (queja?.ID_EmpleadoAsignacion.HasValue == true)
            return "En Proceso";
        return estadoActual?.NombreEstado ?? "N/D";
    }

    private bool PuedeCambiarEstado() => queja?.ID_Estado != lstEstados.FirstOrDefault(e => e.NombreEstado == "Rechazada")?.ID_Estado
        && queja?.ID_Estado != lstEstados.FirstOrDefault(e => e.NombreEstado == "Cerrada")?.ID_Estado;

    private bool PuedeAprobarCompra() => false;

    private bool PuedeCerrar() => false;

    private bool PuedeReabrir() => false;

    private async Task AbrirAsignar()
    {
        var parameters = new DialogParameters { { "IDQueja", queja!.ID_Quejas }, { "IDEmpleadoActual", queja.ID_EmpleadoAsignacion } };
        var dialog = await DialogService.ShowAsync<D_CambiarEstado>("ASIGNAR QUEJA", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await Recargar();
    }

    private async Task AbrirCambiarEstado()
    {
        var parameters = new DialogParameters { { "IDQueja", queja!.ID_Quejas }, { "EstadoActualId", queja.ID_Estado } };
        var dialog = await DialogService.ShowAsync<D_CambiarEstado>("CAMBIAR ESTADO", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await Recargar();
    }

    private async Task AbrirAprobarCompra()
    {
        var dialog = await DialogService.ShowAsync<D_AprobarCompra>("APROBAR COMPRA",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await Recargar();
    }

    private async Task AbrirCerrar()
    {
        var dialog = await DialogService.ShowAsync<D_CerrarQueja>("CERRAR QUEJA", 
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await Recargar();
    }

    private async Task AbrirReabrir()
    {
        var dialog = await DialogService.ShowAsync<D_ReabrirQueja>("REABRIR QUEJA",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled) await Recargar();
    }

    private async Task AbrirHistorial()
    {
        var parameters = new DialogParameters { { "IDQueja", queja!.ID_Quejas } };
        await DialogService.ShowAsync<D_VerHistorial>("HISTORIAL DE QUEJA", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
    }

    private async Task Recargar()
    {
        Cargando = true;
        StateHasChanged();
        await CargarDatos();
        Cargando = false;
        StateHasChanged();
    }

    private string GetNombrePrioridad(int p) => p switch
    {
        1 => "Baja", 2 => "Media", 3 => "Alta", 4 => "Crítica", _ => "N/D"
    };

    private string GetNombreEstado(decimal id) => lstEstados.FirstOrDefault(e => e.ID_Estado == id)?.NombreEstado ?? "N/D";

    private void ToggleOrdenHistorial() => ordenAscendente = !ordenAscendente;

    private string GetEmpleadoNombre(decimal id) => empleadosHistorial.TryGetValue(id, out var nombre) ? nombre : "N/D";

    private string GetEstadoStyle(string estado) => estado switch
    {
        "Nuevo" => "background: #1565c0; color: #fff;",
        "Asignado" => "background: #e65100; color: #fff;",
        "En Proceso" => "background: #f9a825; color: #000;",
        "Pendiente Aprobación" => "background: #6a1b9a; color: #fff;",
        "Resuelto" => "background: #2e7d32; color: #fff;",
        "Cerrada" => "background: #424242; color: #fff;",
        "Rechazada" => "background: #c62828; color: #fff;",
        _ => "background: #888; color: #fff;"
    };
}
