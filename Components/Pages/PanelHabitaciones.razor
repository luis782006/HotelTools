@page "/panelhabitaciones"
@attribute [Authorize(Policy = "ViewHabitacionesStatus")]
@using Microsoft.EntityFrameworkCore

<ValidaPermiso PermisoRequerido="ViewHabitacionesStatus" Objeto="PanelHabitaciones" />

<style>
    .room-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .room-card {
        position: relative;
        flex: 1 1 calc(100% / 6 - 1.5rem);
        min-width: 180px;
        max-width: 280px;
        height: 185px;
        overflow: hidden;
    }
</style>

<MudContainer>
    <MudText Typo="Typo.h4" Class="mb-4">Panel de Habitaciones</MudText>

    @if (Cargando)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-8">
            <MudText Typo="Typo.h6">Cargando habitaciones...</MudText>
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </MudStack>
    }
    else if (lstHabitaciones.Count == 0)
    {
        <MudText Typo="Typo.h6" Align="Align.Center">No hay habitaciones registradas.</MudText>
    }
    else
    {
        <MudPaper Elevation="4" Class="pa-4">
            <div class="room-grid">
                @foreach (var hab in lstHabitaciones)
                {
                    var estado = hab.Estado;
                    var colorBorde = estado.GetColorHex();
                    var chipColor = estado.GetMudColor();
                    var chipLabel = estado.GetLeyenda();

                    <div class="room-card">
                        <MudPaper Elevation="3"
                                  Style="@($"height:100%; border: 3px solid {colorBorde} !important; background: #27272F; border-radius: 8px; display:flex; flex-direction:column;")">
                            <div style="flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:0.75rem;">
                                <MudText Typo="Typo.h3" Style="color: #C1C1C4; font-weight: 700;">
                                    @hab.DescripcionHab
                                </MudText>
                                <MudText Typo="Typo.caption" Style="color: #C1C1C4;">
                                    Max: @hab.MaxPersonas personas
                                </MudText>
                                <MudChip T="string" Size="Size.Small" Style="@($"background: {chipColor}; color: #fff; border-radius: 16px;")" Variant="Variant.Filled">
                                    @chipLabel
                                </MudChip>
                            </div>
                            <div style="display:flex; justify-content:center; gap:0.75rem; padding:0.5rem 0;">
                                <MudTooltip Text="Estado">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" DisableRipple="true"
                                               OnClick="@(() => AbrirEstadoHab(hab))"
                                               Style="min-width:0; padding:0;">
                                        <MudAvatar Size="Size.Small" Variant="Variant.Outlined"
                                                   Style="color: #C1C1C4; border-color: #C1C1C4;">E</MudAvatar>
                                    </MudButton>
                                </MudTooltip>
                                <MudTooltip Text="Inventario">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" DisableRipple="true"
                                               OnClick="@(() => AbrirInventario(hab))"
                                               Style="min-width:0; padding:0;">
                                        <MudAvatar Size="Size.Small" Variant="Variant.Outlined"
                                                   Style="color: #C1C1C4; border-color: #C1C1C4;">I</MudAvatar>
                                    </MudButton>
                                </MudTooltip>
                                <MudTooltip Text="Mucama">
                                    <MudButton Variant="Variant.Text" Size="Size.Small" DisableRipple="true"
                                               OnClick="@(() => AbrirMucama(hab))"
                                               Style="min-width:0; padding:0;">
                                        <MudAvatar Size="Size.Small" Variant="Variant.Outlined"
                                                   Style="color: #C1C1C4; border-color: #C1C1C4;">M</MudAvatar>
                                    </MudButton>
                                </MudTooltip>
                            </div>
                        </MudPaper>
                    </div>
                }
            </div>
        </MudPaper>
    }
</MudContainer>

@code {
    [Inject] private HotelContext Context { get; set; }
    [Inject] private IDialogService DialogService { get; set; }

    private bool Cargando = true;
    private List<HabitacionDto> lstHabitaciones = new();
    private Dictionary<decimal, List<ProductoHabitacionDto>> productosPorHabitacion = new();

    protected override async Task OnInitializedAsync()
    {
        var habitaciones = await Context.Habitaciones.AsNoTracking()
            .OrderBy(h => h.DescripcionHab)
            .ToListAsync();

        var habitacionProductos = await Context.HabitacionProductos.AsNoTracking()
            .ToListAsync();

        var productos = await Context.Productos.AsNoTracking()
            .ToListAsync();

        foreach (var hp in habitacionProductos)
        {
            var prod = productos.FirstOrDefault(p => p.ID_Productos == hp.ID_ProductosFK);
            if (prod != null)
            {
                if (!productosPorHabitacion.ContainsKey(hp.ID_HabFK))
                    productosPorHabitacion[hp.ID_HabFK] = new List<ProductoHabitacionDto>();

                productosPorHabitacion[hp.ID_HabFK].Add(new ProductoHabitacionDto
                {
                    Codigo = prod.Codigo,
                    Descripcion = prod.Descripcion,
                    Cantidad = hp.Cantidad
                });
            }
        }

        lstHabitaciones = habitaciones.Select(h => new HabitacionDto
        {
            ID_NroHab = h.ID_NroHab,
            DescripcionHab = h.DescripcionHab,
            MaxPersonas = h.MaxPersonas,
            Estado = EstadoHabitacionHelper.FromBool(h.Estado),
            TieneProductos = productosPorHabitacion.ContainsKey(h.ID_NroHab)
        }).ToList();

        Cargando = false;
    }

    private async Task AbrirInventario(HabitacionDto hab)
    {
        var productos = productosPorHabitacion.ContainsKey(hab.ID_NroHab)
            ? productosPorHabitacion[hab.ID_NroHab]
            : new List<ProductoHabitacionDto>();

        var parameters = new DialogParameters
        {
            { "Habitacion", hab },
            { "Productos", productos }
        };

        var options = new DialogOptions() { MaxWidth = MaxWidth.Small, FullWidth = true };
        DialogService.Show<PanelHabitacionInventarioPopup>(
            $"Inventario - Habitación {hab.DescripcionHab}",
            parameters,
            options);
    }

    private async Task AbrirEstadoHab(HabitacionDto hab)
    {
        await DialogService.ShowMessageBox(
            $"Estado - Habitación {hab.DescripcionHab}",
            $"Estado actual: {hab.Estado.GetLeyenda()}\nMáximo personas: {hab.MaxPersonas}",
            yesText: "Cerrar");
    }

    private async Task AbrirMucama(HabitacionDto hab)
    {
        await DialogService.ShowMessageBox(
            $"Mucama - Habitación {hab.DescripcionHab}",
            "Módulo de mucama próximamente.",
            yesText: "Cerrar");
    }

    public class HabitacionDto
    {
        public decimal ID_NroHab { get; set; }
        public string DescripcionHab { get; set; } = "";
        public int MaxPersonas { get; set; }
        public EstadoHabitacion Estado { get; set; }
        public bool TieneProductos { get; set; }
    }

    public class ProductoHabitacionDto
    {
        public string Codigo { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public int Cantidad { get; set; }
    }
}