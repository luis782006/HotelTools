@using Microsoft.EntityFrameworkCore
@inject HotelContext Context
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IConfiguration Configuration

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success" @bind-Errors="@errors">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" T="string"
                        @bind-Value="entity.Nombre" Label="Nombre" Required="true"
                        RequiredError="El nombre es requerido" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" T="string"
                        @bind-Value="entity.Apellido" Label="Apellido" Required="true"
                        RequiredError="El apellido es requerido" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect Margin="Margin.Dense" T="decimal" @bind-Value="entity.ID_Cargo"
                        Variant="Variant.Outlined" Label="Cargo" Required="true"
                        RequiredError="Debe seleccionar un cargo">
                        <MudSelectItem Value="0m">-- Seleccione --</MudSelectItem>
                        @foreach (var c in cargos)
                        {
                            <MudSelectItem Value="c.ID_Cargo">@c.NombreCargo</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect Margin="Margin.Dense" T="decimal" @bind-Value="entity.ID_Rol"
                        Variant="Variant.Outlined" Label="Rol" Required="true"
                        RequiredError="Debe seleccionar un rol">
                        <MudSelectItem Value="0m">-- Seleccione --</MudSelectItem>
                        @foreach (var r in roles)
                        {
                            <MudSelectItem Value="r.ID_Rol">@r.NombreRol</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect Margin="Margin.Dense" T="decimal" @bind-Value="entity.ID_Departamento"
                        Variant="Variant.Outlined" Label="Departamento" Required="true"
                        RequiredError="Debe seleccionar un departamento">
                        <MudSelectItem Value="0m">-- Seleccione --</MudSelectItem>
                        @foreach (var d in departamentos)
                        {
                            <MudSelectItem Value="d.ID_Departamento">@d.NombreDepartamento</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" T="string"
                        @bind-Value="entity.NroContacto" Label="Nro Contacto" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudCheckBox Margin="Margin.Dense" T="bool" @bind-Checked="esActivo" Label="Activo" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" T="string"
                        Label="Contraseña" @bind-Value="passwordGenerado"
                        InputType="@passwordInput" Adornment="Adornment.End"
                        AdornmentIcon="@passwordInputIcon" OnAdornmentClick="TogglePasswordVisibilidad" />
                    <MudButton OnClick="GenerarPassword" Variant="Variant.Outlined"
                        Color="Color.Info" Size="Size.Small" Class="mt-1">
                        Generar Contraseña
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Color="Color.Error" Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Cancel">Cancelar</MudButton>
        <MudButton OnClick="Guardar" Color="Color.Success" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Save" Disabled="!success">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    private bool success = true;
    private string[] errors = { };
    private Empleado entity = new();
    private MudForm? form;
    private bool esActivo = true;
    private string passwordGenerado = "";
    private bool passVisible;
    private string passwordInputIcon = Icons.Material.Filled.VisibilityOff;
    private InputType passwordInput = InputType.Password;

    private List<Cargo> cargos = new();
    private List<Departamento> departamentos = new();
    private List<Rol> roles = new();

    protected override async Task OnInitializedAsync()
    {
        cargos = await Context.Cargo.AsNoTracking().ToListAsync();
        departamentos = await Context.Departamentos.AsNoTracking().ToListAsync();
        roles = await Context.Rol.AsNoTracking().ToListAsync();
        entity.Activo = 1;
        GenerarPassword();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            form?.Validate();
            StateHasChanged();
        }
    }

    private void GenerarPassword()
    {
        var chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%";
        var random = new Random();
        passwordGenerado = new string(Enumerable.Range(0, 10).Select(_ => chars[random.Next(chars.Length)]).ToArray());
    }

    private void TogglePasswordVisibilidad()
    {
        passVisible = !passVisible;
        passwordInputIcon = passVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
        passwordInput = passVisible ? InputType.Text : InputType.Password;
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task Guardar()
    {
        var confirm = await DialogService.ShowMessageBox("Confirmar", "¿Desea guardar el nuevo usuario?",
            yesText: "Guardar", cancelText: "Cancelar");
        if (confirm != true) return;

        try
        {
            entity.Activo = esActivo ? (byte)1 : (byte)0;
            entity.Password = PasswordHasher.HashPassword(passwordGenerado, Configuration);
            entity.FechaDesde = DateTime.Now;
            entity.FechaHasta = DateTime.MaxValue;

            Context.Empleados.Add(entity);
            await Context.SaveChangesAsync();

            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
            Snackbar.Add($"Usuario {entity.Nombre} {entity.Apellido} registrado. Contraseña: {passwordGenerado}", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            var inner = ex.InnerException?.Message ?? ex.Message;
            Snackbar.Add($"Error: {inner}", Severity.Error);
        }
    }
}
