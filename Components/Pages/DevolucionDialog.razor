@using HotelTools.Services
@using Microsoft.EntityFrameworkCore

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">Devolución</MudText>

        <MudStack Spacing="2">
            <MudText Typo="Typo.body2" Style="color: #888;">
                <strong>Producto:</strong> @Producto.Codigo — @Producto.Descripcion
            </MudText>
            <MudText Typo="Typo.body2" Style="color: #888;">
                <strong>Origen actual:</strong> @HabitacionOrigen.DescripcionHab
            </MudText>
            <MudText Typo="Typo.body2" Style="color: #1565c0;">
                ℹ Si el destino es la casa, se restablece como nativo. Si es otra habitación, se mantiene como préstamo.
            </MudText>

            <MudSelect T="decimal" @bind-Value="DestinoSeleccionado" Label="Habitación destino"
                       Variant="Variant.Outlined" Class="mt-2">
                @foreach (var hab in DestinosDisponibles)
                {
                    <MudSelectItem Value="@hab.ID_NroHab">
                        @hab.DescripcionHab@(hab.ID_NroHab == Producto.ID_HabitacionCasa ? " (Casa)" : "")
                    </MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="Observaciones" Label="Observaciones (opcional)"
                          Variant="Variant.Outlined" Lines="2" Class="mt-2" />
        </MudStack>

        @if (!string.IsNullOrEmpty(MensajeError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@MensajeError</MudAlert>
        }
        @if (!string.IsNullOrEmpty(MensajeExito))
        {
            <MudAlert Severity="Severity.Success" Class="mt-3">@MensajeExito</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Color="Color.Error" Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Cancel">
            Cancelar
        </MudButton>
        <MudButton OnClick="Confirmar" Color="Color.Success" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Undo" Disabled="@Procesando">
            @if (Procesando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Confirmar Devolución
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public PanelHabitaciones.InventarioProductoDto Producto { get; set; }
    [Parameter] public PanelHabitaciones.HabitacionDto HabitacionOrigen { get; set; }
    [Parameter] public List<PanelHabitaciones.HabitacionDto> TodasHabitaciones { get; set; } = new();

    [Inject] private PrestamoService PrestamoService { get; set; }
    [Inject] private SeguridadSesion Sesion { get; set; }
    [Inject] private ISnackbar Snackbar { get; set; }

    private decimal DestinoSeleccionado;
    private string Observaciones = "";
    private string MensajeError = "";
    private string MensajeExito = "";
    private bool Procesando = false;

    private List<PanelHabitaciones.HabitacionDto> DestinosDisponibles => TodasHabitaciones
        .Where(h => h.ID_NroHab != HabitacionOrigen.ID_NroHab)
        .ToList();

    protected override void OnInitialized()
    {
        if (DestinosDisponibles.Count > 0)
            DestinoSeleccionado = DestinosDisponibles.First().ID_NroHab;
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task Confirmar()
    {
        MensajeError = "";
        MensajeExito = "";
        Procesando = true;
        StateHasChanged();

        var resultado = await PrestamoService.Devolucion(
            Producto.ID_Producto,
            DestinoSeleccionado,
            Sesion.EmpleadoActual.ID_Empleado,
            string.IsNullOrWhiteSpace(Observaciones) ? null : Observaciones);

        if (resultado.Exito)
        {
            MensajeExito = resultado.Mensaje;
            Snackbar.Add(resultado.Mensaje, Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            MensajeError = resultado.Mensaje;
        }

        Procesando = false;
    }
}
