@page "/home"

@inject IJSRuntime js
@inject NavigationManager nav;
@using Microsoft.AspNetCore.Components.Authorization
@inject BrowserJS browserJS;

<AuthorizeView>
    <Authorized>
        <h1>Bienvenido, @context.User.Identity?.Name!</h1>
        <p>Rol: @GetRole()</p>
    </Authorized>
    <NotAuthorized>
        <h1>No autorizado</h1>
        <p>Debes iniciar sesión para acceder a esta página.</p>
        <button class="btn btn-primary" @onclick="GoToLogin">Ir a Login</button>
    </NotAuthorized>
</AuthorizeView>

<AuthorizeView Roles="Admin">
    <Authorized>
        <br/>
        <br/>
        <MudText Typo="Typo.h5">Panel de Administración</MudText>
        <MudText Typo="Typo.body1">Tienes acceso a todas las configuraciones del sistema.</MudText>
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="User">
    <Authorized>
        <br/>
        <br/>
        <MudText Typo="Typo.h5">Panel de Usuario</MudText>
        <MudText Typo="Typo.body1">Bienvenido al sistema HotelTools.</MudText>
    </Authorized>
</AuthorizeView>

@code{
    [CascadingParameter]
    Task<AuthenticationState> AuthenticationTask { get; set; }

    private string GetRole()
    {
        var authState = AuthenticationTask.Result;
        if (authState?.User?.Identity?.IsAuthenticated == true)
        {
            var role = authState.User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
            return role ?? "Sin rol";
        }
        return "Sin rol";
    }

    private void GoToLogin()
    {
        nav.NavigateTo("/login", true);
    }
}
