@page "/listatipoproductos"
@attribute [Authorize(Policy = "ManageInventario")]

@using Microsoft.EntityFrameworkCore
@using OfficeOpenXml

<ValidaPermiso PermisoRequerido="ManageInventario" Objeto="ListaTipoProductos" />

<MudContainer>
    <MudText Typo="Typo.h4">Listado de Productos</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Catálogo de tipos de producto disponibles para los paquetes</MudText>
    <MudTabs @bind-ActivePanelIndex="tabIndex" Elevation="0" Rounded="true" Border="true" Class="mt-4">
        <MudTabPanel Text="Listado" Icon="@Icons.Material.Filled.List">
            <MudPaper Class="d-flex justify-content-center p-4 mt-4" Width="100%">
                <MudPaper Style="width:80rem;">
                    @if (Cargando)
                    {
                        <MudGrid Style="text-align:center;">
                            <MudItem sm="12">
                                <MudText Typo="Typo.h6">Cargando registros...</MudText>
                                <MudProgressCircular Color="Color.Primary" Style="height:70px;width:70px;" Indeterminate="true" />
                            </MudItem>
                        </MudGrid>
                    }
                    else
                    {
                        <MudTable Items="@lstTipoProductos" Breakpoint="Breakpoint.Md" Style="width:100%;padding:1rem; margin:auto;" Dense="true" Hover="true" Striped="true" @ref="table" FixedHeader="true" Filter="new Func<TipoProductoListDto,bool>(FilterFunc1)">
                            <ToolBarContent>
                                <MudStack Row="true" Justify="Justify.SpaceBetween" Style="width:100%;">
                                    <MudTextField T="string" @bind-Value="searchString" Style="width:300px;" Placeholder="Buscar..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
                                    <MudTooltip Text="Agregar Producto">
                                        <MudFab Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" Color="Color.Success" OnClick="@(() => AccionTipoProducto(maxWidth, "Insertar", 0))" />
                                    </MudTooltip>
                                </MudStack>
                            </ToolBarContent>
                            <HeaderContent>
                                <MudTh>Acciones</MudTh>
                                <MudTh Style="text-align:left;">Nombre</MudTh>
                                <MudTh Style="text-align:left;">Descripción</MudTh>
                                <MudTh Style="text-align:left;">Categoría</MudTh>
                                <MudTh Style="text-align:left;">Modelo</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd Class="d-inline-flex justify-center">
                                    <MudTooltip Text="Ver Producto">
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Search" Color="Color.Info" OnClick="@((e) => AccionTipoProducto(maxWidth, "Ver", @context.ID_TipoProducto))" />
                                    </MudTooltip>
                                    <MudTooltip Text="Editar Producto">
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Success" OnClick="@((e) => AccionTipoProducto(maxWidth, "Editar", @context.ID_TipoProducto))" />
                                    </MudTooltip>
                                    <MudTooltip Text="Eliminar Producto">
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@((e) => AccionTipoProducto(maxWidth, "Eliminar", @context.ID_TipoProducto))" />
                                    </MudTooltip>
                                </MudTd>
                                <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
                                <MudTd DataLabel="Descripcion">
                                    @if (string.IsNullOrEmpty(context.Descripcion))
                                    {
                                        <MudText Typo="Typo.body2" Style="color: #888;">—</MudText>
                                    }
                                    else
                                    {
                                        @context.Descripcion
                                    }
                                </MudTd>
                                <MudTd DataLabel="Categoria">@context.Categoria</MudTd>
                                <MudTd DataLabel="Modelo">@context.Modelo</MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager RowsPerPageString="Filas por Pagina." InfoFormat="@($"Filas {infoFormat}")" HorizontalAlignment="HorizontalAlignment.Center" PageSizeOptions="new int[] { 25, 50, 100 }" />
                            </PagerContent>
                        </MudTable>
                    }
                </MudPaper>
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="Carga Masiva (Excel)" Icon="@Icons.Material.Filled.UploadFile">
            <MudPaper Class="pa-6 mt-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudButton OnClick="DescargarTemplate" Variant="Variant.Outlined" Color="Color.Info">
                        <MudIcon Icon="@Icons.Material.Filled.Download" Class="mr-2" /> Descargar Template
                    </MudButton>
                    <InputFile OnChange="@OnFilesSelected" accept=".xlsx" />
                </MudStack>

                @if (!string.IsNullOrEmpty(nombreArchivo))
                {
                    <MudText Class="mt-3 mud-text-secondary">Archivo: @nombreArchivo</MudText>
                }

                @if (filasImport.Count > 0)
                {
                    <MudText Typo="Typo.h6" Class="mt-4">Vista previa (@filasImport.Count registros)</MudText>
                    <MudTable Items="filasImport" Dense="true" Hover="true" Class="mt-2" Striped="true">
                        <HeaderContent>
                            <MudTh>Fila</MudTh>
                            <MudTh>Nombre</MudTh>
                            <MudTh>Descripción</MudTh>
                            <MudTh>Categoría</MudTh>
                            <MudTh>Modelo</MudTh>
                            <MudTh>Estado</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Fila">@context.RowNumber</MudTd>
                            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
                            <MudTd DataLabel="Descripcion">
                                @if (string.IsNullOrEmpty(context.Descripcion))
                                {
                                    <MudText Typo="Typo.body2" Style="color: #888;">—</MudText>
                                }
                                else
                                {
                                    @context.Descripcion
                                }
                            </MudTd>
                            <MudTd DataLabel="Categoria">@context.Categoria</MudTd>
                            <MudTd DataLabel="Modelo">@context.Modelo</MudTd>
                            <MudTd DataLabel="Estado">
                                @if (context.Errores.Count > 0)
                                {
                                    <MudText Color="Color.Error" Class="mud-text-small">@string.Join("; ", context.Errores)</MudText>
                                }
                                else
                                {
                                    <MudText Color="Color.Success">Válido</MudText>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>

                    <MudText Class="mt-2">
                        @filasImport.Count(r => r.Valido) válidos, @filasImport.Count(r => !r.Valido) con errores
                    </MudText>

                    <MudButton OnClick="ImportarTipoProductos" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                        Disabled="importando || filasImport.Count(r => r.Valido) == 0">
                        Importar Productos
                    </MudButton>
                }
                @if (importoExito)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-3" Variant="Variant.Outlined">@mensajeExito</MudAlert>
                }
                @if (importoError)
                {
                    <MudAlert Severity="Severity.Error" Class="mt-3" Variant="Variant.Outlined">@mensajeError</MudAlert>
                }
            </MudPaper>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    private int tabIndex;

    // Listado
    private MudTable<TipoProductoListDto> table;
    private string searchString = "";
    private string infoFormat = "{first_item}-{last_item} de {all_items}";
    private bool Cargando = true;

    private List<TipoProductoListDto> lstTipoProductos = new();
    private Dictionary<decimal, string> categoriaLookup = new();
    private Dictionary<decimal, string> modeloLookup = new();

    // Carga Masiva
    private bool importando, importoExito, importoError;
    private string nombreArchivo = "", mensajeExito = "", mensajeError = "";
    private List<TipoProductoImportRow> filasImport = new();
    private List<CategoriaProducto> categorias = new();
    private List<Modelo> modelos = new();

    [Inject] private HotelContext Context { get; set; }
    [Inject] private IDialogService DialogService { get; set; }
    [Inject] private IJSRuntime Js { get; set; }

    private DialogOptions maxWidth = new DialogOptions() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        categorias = await Context.CategoriasProductos.AsNoTracking().OrderBy(c => c.NombreCatProductos).ToListAsync();
        modelos = await Context.Modelos.AsNoTracking().OrderBy(m => m.NombreModelos).ToListAsync();
        categoriaLookup = categorias.ToDictionary(c => c.ID_CategoriasPro, c => c.NombreCatProductos);
        modeloLookup = modelos.ToDictionary(m => m.ID_Modelos, m => m.NombreModelos);
        await CargarListado();
    }

    private async Task CargarListado()
    {
        Cargando = true;
        lstTipoProductos = await Context.TipoProductos.AsNoTracking()
            .OrderBy(t => t.Nombre)
            .Select(t => new TipoProductoListDto
            {
                ID_TipoProducto = t.ID_TipoProducto,
                Nombre = t.Nombre,
                Descripcion = t.Descripcion,
                ID_CategoriaProFK = t.ID_CategoriaProFK,
                ID_ModelosFK = t.ID_ModelosFK
            })
            .ToListAsync();

        foreach (var item in lstTipoProductos)
        {
            item.Categoria = categoriaLookup.ContainsKey(item.ID_CategoriaProFK)
                ? categoriaLookup[item.ID_CategoriaProFK]
                : "";
            item.Modelo = modeloLookup.ContainsKey(item.ID_ModelosFK)
                ? modeloLookup[item.ID_ModelosFK]
                : "";
        }

        Cargando = false;
    }

    private bool FilterFunc1(TipoProductoListDto element) => FilterFunc(element, searchString);

    private bool FilterFunc(TipoProductoListDto element, string search)
    {
        if (string.IsNullOrWhiteSpace(search))
            return true;
        if (element.Nombre.Contains(search, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.Descripcion != null && element.Descripcion.Contains(search, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.Categoria.Contains(search, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.Modelo.Contains(search, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    private async Task AccionTipoProducto(DialogOptions options, string modo, decimal id)
    {
        var parameters = new DialogParameters
        {
            { "Modo", modo },
            { "ID", id }
        };
        var dialog = DialogService.Show<D_TipoProducto>(modo.ToUpper() + " PRODUCTO", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await CargarListado();
            StateHasChanged();
        }
    }

    // ===================== CARGA MASIVA =====================

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        filasImport.Clear();
        nombreArchivo = "";
        importoExito = false;
        importoError = false;

        var file = e.File;
        if (file == null) return;

        nombreArchivo = file.Name;

        ExcelPackage.LicenseContext = LicenseContext.NonCommercial;

        using var stream = new MemoryStream();
        await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(stream);
        stream.Position = 0;

        using var package = new ExcelPackage(stream);
        var worksheet = package.Workbook.Worksheets[0];
        if (worksheet == null)
        {
            mensajeError = "El archivo no contiene datos en la primera hoja.";
            importoError = true;
            return;
        }

        var rowCount = worksheet.Dimension?.Rows ?? 0;
        if (rowCount < 2)
        {
            mensajeError = "El archivo no contiene datos (solo cabecera).";
            importoError = true;
            return;
        }

        for (int row = 2; row <= rowCount; row++)
        {
            var importRow = new TipoProductoImportRow
            {
                RowNumber = row,
                Nombre = worksheet.Cells[row, 1].Text?.Trim() ?? "",
                Descripcion = worksheet.Cells[row, 2].Text?.Trim() ?? "",
                Categoria = worksheet.Cells[row, 3].Text?.Trim() ?? "",
                Modelo = worksheet.Cells[row, 4].Text?.Trim() ?? ""
            };

            if (string.IsNullOrWhiteSpace(importRow.Nombre))
                importRow.Errores.Add("Nombre requerido");
            else if (importRow.Nombre.Length > 60)
                importRow.Errores.Add("Máximo 60 caracteres");

            if (!string.IsNullOrWhiteSpace(importRow.Descripcion) && importRow.Descripcion.Length > 200)
                importRow.Errores.Add("Descripción máx. 200 caracteres");

            if (string.IsNullOrWhiteSpace(importRow.Categoria))
                importRow.Errores.Add("Categoría requerida");

            if (string.IsNullOrWhiteSpace(importRow.Modelo))
                importRow.Errores.Add("Modelo requerido");

            filasImport.Add(importRow);
        }
    }

    private async Task ImportarTipoProductos()
    {
        importando = true;
        importoExito = false;
        importoError = false;

        try
        {
            var validos = filasImport.Where(r => r.Valido).ToList();
            var productos = new List<TipoProducto>();
            var errores = new List<string>();

            foreach (var row in validos)
            {
                var categoria = categorias.FirstOrDefault(c =>
                    c.NombreCatProductos.Trim().Equals(row.Categoria, StringComparison.OrdinalIgnoreCase))
                    ?? categorias.FirstOrDefault(c => c.ID_CategoriasPro.ToString() == row.Categoria.Trim());

                if (categoria == null)
                {
                    var disponibles = string.Join(", ", categorias.Select(c => c.NombreCatProductos));
                    errores.Add($"Fila {row.RowNumber}: Categoría '{row.Categoria}' no encontrada. Categorías disponibles: {disponibles}");
                    continue;
                }

                var modelo = modelos.FirstOrDefault(m =>
                    m.NombreModelos.Trim().Equals(row.Modelo, StringComparison.OrdinalIgnoreCase))
                    ?? modelos.FirstOrDefault(m => m.ID_Modelos.ToString() == row.Modelo.Trim());

                if (modelo == null)
                {
                    var disponibles = string.Join(", ", modelos.Select(m => m.NombreModelos));
                    errores.Add($"Fila {row.RowNumber}: Modelo '{row.Modelo}' no encontrado. Modelos disponibles: {disponibles}");
                    continue;
                }

                productos.Add(new TipoProducto
                {
                    Nombre = row.Nombre.Trim(),
                    Descripcion = string.IsNullOrWhiteSpace(row.Descripcion) ? null : row.Descripcion.Trim(),
                    ID_CategoriaProFK = categoria.ID_CategoriasPro,
                    ID_ModelosFK = modelo.ID_Modelos
                });
            }

            int insertados = 0;
            if (productos.Count > 0)
            {
                Context.TipoProductos.AddRange(productos);
                await Context.SaveChangesAsync();
                insertados = productos.Count;
            }

            if (insertados == 0)
            {
                mensajeError = "No se importó ningún producto." + (errores.Count > 0
                    ? "\n" + string.Join("\n", errores) : "");
                importoError = true;
            }
            else
            {
                mensajeExito = $"{insertados} productos importados correctamente.";
                if (errores.Count > 0)
                    mensajeExito += "\nSe omitieron filas: " + string.Join(" | ", errores);
                importoExito = true;
                tabIndex = 0;
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error durante la importación: {ex.InnerException?.Message ?? ex.Message}";
            importoError = true;
        }
        finally
        {
            importando = false;
            filasImport.Clear();
            nombreArchivo = "";
            await CargarListado();
            StateHasChanged();
        }
    }

    private async Task DescargarTemplate()
    {
        ExcelPackage.LicenseContext = LicenseContext.NonCommercial;
        using var package = new ExcelPackage();
        var sheet = package.Workbook.Worksheets.Add("TipoProductos");
        sheet.Cells[1, 1].Value = "Nombre";
        sheet.Cells[1, 2].Value = "Descripcion";
        sheet.Cells[1, 3].Value = "Categoria";
        sheet.Cells[1, 4].Value = "Modelo";
        sheet.Cells[1, 1, 1, 4].Style.Font.Bold = true;

        var data = package.GetAsByteArray();
        var ms = new MemoryStream(data);
        using var streamRef = new DotNetStreamReference(ms);
        await Js.InvokeVoidAsync("downloadFileFromStream", "template_tipo_productos.xlsx", streamRef);
    }

    // ===================== DTOs =====================

    public class TipoProductoListDto
    {
        public decimal ID_TipoProducto { get; set; }
        public string Nombre { get; set; } = "";
        public string? Descripcion { get; set; }
        public decimal ID_CategoriaProFK { get; set; }
        public decimal ID_ModelosFK { get; set; }
        public string Categoria { get; set; } = "";
        public string Modelo { get; set; } = "";
    }

    public class TipoProductoImportRow
    {
        public int RowNumber { get; set; }
        public string Nombre { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public string Categoria { get; set; } = "";
        public string Modelo { get; set; } = "";
        public List<string> Errores { get; set; } = new();
        public bool Valido => Errores.Count == 0;
    }
}