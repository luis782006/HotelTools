@using Microsoft.EntityFrameworkCore
@inject HotelContext Context
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success" @bind-Errors="@errors">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" T="string"
                        @bind-Value="departamento.NombreDepartamento" Label="Nombre del Departamento"
                        ReadOnly="@SoloLectura" Required="true"
                        RequiredError="El nombre del departamento es requerido" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Color="Color.Error" Variant="Variant.Outlined"
            StartIcon="@Icons.Material.Filled.Cancel">
            @(Modo == "Ver" ? "Cerrar" : "Cancelar")
        </MudButton>
        @if (Modo == "Eliminar")
        {
            <MudButton OnClick="ConfirmarEliminar"
                Color="Color.Error" Variant="Variant.Filled"
                StartIcon="@Icons.Material.Filled.Delete">
                Eliminar
            </MudButton>
        }
        @if (Modo != "Ver" && Modo != "Eliminar")
        {
            <MudButton OnClick="ConfirmarGuardar"
                Disabled="!success"
                Color="Color.Success" Variant="Variant.Filled"
                StartIcon="@Icons.Material.Filled.Save">
                Guardar
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Modo { get; set; } = "Ver";
    [Parameter] public decimal ID { get; set; }

    private bool SoloLectura;
    private bool success = true;
    private string[] errors = { };

    private Departamento departamento = new();
    private MudForm? form;

    protected override async Task OnInitializedAsync()
    {
        SoloLectura = Modo == "Ver" || Modo == "Eliminar";

        if (ID > 0)
        {
            var d = await Context.Departamentos.FindAsync(ID);
            if (d != null)
                departamento = d;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && Modo != "Ver" && Modo != "Eliminar")
        {
            form?.Validate();
            StateHasChanged();
        }
    }

    private async Task ConfirmarGuardar()
    {
        var confirm = await DialogService.ShowMessageBox(
            "Confirmar",
            "¿Desea guardar los cambios?",
            yesText: "Guardar",
            cancelText: "Cancelar");

        if (confirm == true)
        {
            await Guardar();
        }
    }

    private async Task Guardar()
    {
        try
        {
            if (Modo == "Insertar")
            {
                Context.Departamentos.Add(departamento);
            }
            else
            {
                Context.Departamentos.Update(departamento);
            }

            await Context.SaveChangesAsync();

            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
            Snackbar.Add(Modo == "Insertar" ? "Departamento creado correctamente" : "Departamento actualizado correctamente", Severity.Success);

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
    }

    private async Task ConfirmarEliminar()
    {
        var confirm = await DialogService.ShowMessageBox(
            "Confirmar Eliminación",
            "¿Está seguro de eliminar este departamento?",
            yesText: "Eliminar",
            cancelText: "Cancelar");

        if (confirm == true)
        {
            await Eliminar();
        }
    }

    private async Task Eliminar()
    {
        try
        {
            Context.Departamentos.Remove(departamento);
            await Context.SaveChangesAsync();

            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
            Snackbar.Add("Departamento eliminado correctamente", Severity.Success);

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al eliminar: {ex.Message}", Severity.Error);
        }
    }

    void Cancelar() => MudDialog.Cancel();
}
