@using Microsoft.EntityFrameworkCore
@inject HotelContext Context
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success" @bind-Errors="@errors" Margin="Margin.Dense">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" T="string"
                        @bind-Value="permiso.Codigo" Label="Codigo"
                        ReadOnly="@SoloLectura" Required="true"
                        RequiredError="El codigo del permiso es requerido" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Outlined" T="string"
                        @bind-Value="permiso.Descripcion" Label="Descripcion"
                        ReadOnly="@SoloLectura" Required="true"
                        RequiredError="La descripcion del permiso es requerida" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Color="Color.Error" Variant="Variant.Outlined"
            StartIcon="@Icons.Material.Filled.Cancel">
            @(Modo == "Ver" ? "Cerrar" : "Cancelar")
        </MudButton>
        @if (Modo != "Ver")
        {
            <MudButton OnClick="ConfirmarGuardar"
                Color="Color.Success" Variant="Variant.Filled"
                StartIcon="@Icons.Material.Filled.Save">
                @(Modo == "Insertar" ? "Guardar" : "Guardar")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public string Modo { get; set; } = "Ver";
    [Parameter] public decimal ID { get; set; }

    private bool SoloLectura;
    private bool success = true;
    private string[] errors = { };

    private Permiso permiso = new();
    private MudForm? form;

    protected override async Task OnInitializedAsync()
    {
        SoloLectura = Modo == "Ver";

        if (ID > 0)
        {
            var p = await Context.Permisos.FindAsync(ID);
            if (p != null)
                permiso = p;
        }
    }

    private async Task ConfirmarGuardar()
    {
        var confirm = await DialogService.ShowMessageBox(
            "Confirmar",
            "¿Desea guardar los cambios?",
            yesText: "Guardar",
            cancelText: "Cancelar");

        if (confirm == true)
        {
            await Guardar();
        }
    }

    private async Task Guardar()
    {
        try
        {
            if (Modo == "Insertar")
            {
                Context.Permisos.Add(permiso);
            }
            else
            {
                Context.Permisos.Update(permiso);
            }

            await Context.SaveChangesAsync();

            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
            Snackbar.Add(Modo == "Insertar" ? "Permiso creado correctamente" : "Permiso actualizado correctamente", Severity.Success);

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
    }

    void Cancelar() => MudDialog.Cancel();
}
