@page "/listacategoriahabitaciones"
@attribute [Authorize(Policy = "ManageConfiguraciones")]

@using Microsoft.EntityFrameworkCore

<ValidaPermiso PermisoRequerido="ManageConfiguraciones" Objeto="ListaCategoriaHabitaciones" />

<MudContainer>
    <MudText Typo="Typo.h4">Listado de Categorías de Habitaciones</MudText>
    <MudPaper Class="d-flex justify-content-center p-4" Width="100%">
        <MudPaper Style="width:80rem;">
            @if (Cargando)
            {
                <MudGrid Style="text-align:center;">
                    <MudItem sm="12">
                        <MudText Typo="Typo.h6">Cargando registros...</MudText>
                        <MudProgressCircular Color="Color.Primary" Style="height:70px;width:70px;" Indeterminate="true" />
                    </MudItem>
                </MudGrid>
            }
            else
            {
                <MudTable Items="@lstCategorias" Breakpoint="Breakpoint.Md" Style="width:100%;padding:1rem; margin:auto;" Dense="true" Hover="true" Striped="true" @ref="table" FixedHeader="true" Filter="new Func<CategoriaHabitacion,bool>(FilterFunc1)">
                    <ToolBarContent>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" Style="width:100%;">
                            <MudTextField T="string" @bind-Value="searchString" Style="width:300px;" Placeholder="Buscar..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
                            <MudTooltip Text="Agregar Categoría">
                                <MudFab Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" Color="Color.Success" OnClick="@(() => AccionCategoria(maxWidth, "Insertar", 0))" />
                            </MudTooltip>
                        </MudStack>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>Acciones</MudTh>
                        <MudTh Style="text-align:left;">Tipo de Habitación</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Class="d-inline-flex justify-center">
                            <MudTooltip Text="Ver Categoría">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Search" Color="Color.Info" OnClick="@((e) => AccionCategoria(maxWidth, "Ver", @context.ID_Categoria))" />
                            </MudTooltip>
                            <MudTooltip Text="Editar Categoría">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Success" OnClick="@((e) => AccionCategoria(maxWidth, "Editar", @context.ID_Categoria))" />
                            </MudTooltip>
                            <MudTooltip Text="Eliminar Categoría">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@((e) => AccionCategoria(maxWidth, "Eliminar", @context.ID_Categoria))" />
                            </MudTooltip>
                        </MudTd>
                        <MudTd DataLabel="Tipo">@context.TipoHab</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager RowsPerPageString="Filas por Pagina." InfoFormat="@($"Filas {infoFormat}")" HorizontalAlignment="HorizontalAlignment.Center" PageSizeOptions="new int[] { 25, 50, 100 }" />
                    </PagerContent>
                </MudTable>
            }
        </MudPaper>
    </MudPaper>
</MudContainer>

@code {
    private MudTable<CategoriaHabitacion> table;
    private string searchString = "";
    private string infoFormat = "{first_item}-{last_item} de {all_items}";
    private bool Cargando = true;

    private List<CategoriaHabitacion> lstCategorias = new();

    [Inject] private HotelContext Context { get; set; }
    [Inject] private IDialogService DialogService { get; set; }

    private DialogOptions maxWidth = new DialogOptions() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarDatos();
            Cargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarDatos()
    {
        lstCategorias = await Context.CategoriaHabitaciones.AsNoTracking().OrderBy(c => c.TipoHab).ToListAsync();
    }

    private bool FilterFunc1(CategoriaHabitacion element) => FilterFunc(element, searchString);

    private bool FilterFunc(CategoriaHabitacion element, string search)
    {
        if (string.IsNullOrWhiteSpace(search))
            return true;
        if (element.TipoHab.Contains(search, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    private async Task AccionCategoria(DialogOptions options, string modo, decimal id)
    {
        var parameters = new DialogParameters
        {
            { "Modo", modo },
            { "ID", id }
        };
        var dialog = DialogService.Show<D_CategoriaHabitacion>(modo.ToUpper() + " CATEGORÍA", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await CargarDatos();
            StateHasChanged();
        }
    }
}
