@page "/cargaproductos"
@attribute [Authorize(Policy = "ManageConfiguraciones")]
@using Microsoft.EntityFrameworkCore

<ValidaPermiso PermisoRequerido="ManageConfiguraciones" Objeto="CargaProductos" />

<MudContainer>
    <MudText Typo="Typo.h4" Class="mb-4">Carga de Productos</MudText>

    @if (Cargando)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-8">
            <MudText Typo="Typo.h6">Cargando datos...</MudText>
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </MudStack>
    }
    else
    {
        <MudPaper Elevation="4" Class="pa-4">

            @* Selector de categoría *@
            <MudSelect T="decimal" @bind-Value="categoriaSeleccionada" Label="Categoría de Habitación"
                       Variant="Variant.Outlined" Class="mb-4" AdornmentIcon="@Icons.Material.Filled.FilterList"
                       SelectedValuesChanged="@OnCategoriaChanged">
                <MudSelectItem Value="0m">-- Seleccione una categoría --</MudSelectItem>
                @foreach (var cat in lstCategorias)
                {
                    <MudSelectItem Value="@cat.ID_Categoria">@cat.TipoHab</MudSelectItem>
                }
            </MudSelect>

            @* Selector de paquete *@
            <MudText Typo="Typo.subtitle1" Class="mb-2" Style="font-weight:600;">Paquete</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
                <MudSelect T="decimal" @bind-Value="paqueteSeleccionado" Label="Paquete de productos"
                           Variant="Variant.Outlined" AdornmentIcon="@Icons.Material.Filled.Inventory"
                           Class="mr-2" Style="min-width: 280px; max-width: 400px;"
                           SelectedValuesChanged="@OnPaqueteChanged">
                    @if (lstPaquetes.Count == 0)
                    {
                        <MudSelectItem Value="0m">-- No hay paquetes para esta categoría --</MudSelectItem>
                    }
                    else
                    {
                        <MudSelectItem Value="0m">-- Seleccione un paquete --</MudSelectItem>
                        @foreach (var p in lstPaquetes)
                        {
                            <MudSelectItem Value="@p.ID_Paquete">@p.Nombre</MudSelectItem>
                        }
                    }
                </MudSelect>

                <MudTooltip Text="Administrar paquetes">
                    <MudIconButton Size="Size.Medium" Icon="@Icons.Material.Filled.Edit" Color="Color.Info"
                                   OnClick="@AbrirAdministradorPaquetes" />
                </MudTooltip>
            </MudStack>

            @* Habitaciones *@
            <MudText Typo="Typo.subtitle1" Class="mb-2" Style="font-weight:600;">Habitaciones</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
                <MudCheckBox T="bool" @bind-Value="todasSeleccionadas" Label="Seleccionar todo"
                             Color="Color.Primary" />
                <MudChipSet T="decimal" SelectionMode="SelectionMode.MultiSelection"
                            SelectedValues="habitacionesSeleccionadas"
                            SelectedValuesChanged="OnHabitacionesChanged"
                            CheckMark="true"
                            Variant="Variant.Filled">
                    @foreach (var hab in lstHabitacionesFiltradas)
                    {
                        <MudChip Value="@hab.ID_NroHab" Text="@hab.DescripcionHab" Default="@(habitacionesSeleccionadas.Contains(hab.ID_NroHab))" />
                    }
                </MudChipSet>
            </MudStack>

            @if (lstHabitacionesFiltradas.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Warning" Class="mb-4">
                    No hay habitaciones para esta categoría.
                </MudText>
            }

            <MudDivider Class="my-4" />

            @* Productos del paquete *@
            <MudText Typo="Typo.subtitle1" Class="mb-2" Style="font-weight:600;">Productos del paquete</MudText>

            @if (lstProductos.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Warning" Class="mb-4">
                    Seleccione un paquete para cargar sus productos.
                </MudText>
            }
            else
            {
                @* Checkbox seleccionar todos los productos *@
                <MudCheckBox T="bool" @bind-Value="todosProductosMarcados" Label="Marcar/Desmarcar todos los productos"
                             Color="Color.Primary" Class="mb-2" />

                @* Generar códigos *@
                <MudRadioGroup T="bool" @bind-Value="generarCodigos" Class="mb-2">
                    <MudRadio T="bool" Value="true" Color="Color.Primary">Generar Código</MudRadio>
                    <MudRadio T="bool" Value="false" Color="Color.Primary">No Generar Código</MudRadio>
                </MudRadioGroup>

                @* Lista de productos *@
                <MudStack Class="mb-4" Style="max-height: 400px; overflow-y: auto;">
                    @foreach (var prod in lstProductos)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-2"
                                  Style="border: 1px solid #3a3a4a; border-radius: 8px; background: #1e1e2e;">

                            <MudCheckBox T="bool" @bind-Value="prod.Seleccionado" Color="Color.Primary" />

                            <MudTooltip Text="@(string.IsNullOrEmpty(prod.DescripcionDetalle) ? "Sin descripción" : prod.DescripcionDetalle)" Placement="Placement.Top">
                                <MudText Typo="Typo.body1" Style="color: #C1C1C4; min-width: 200px;">
                                    @prod.Descripcion
                                    @if (!string.IsNullOrEmpty(prod.Categoria))
                                    {
                                        <MudText Typo="Typo.caption" Style="color: #888;"> (@prod.Categoria · @prod.Modelo)</MudText>
                                    }
                                </MudText>
                            </MudTooltip>

                            <MudSpacer />

                            <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined">
                                <MudButton OnClick="@(() => prod.Cantidad = Math.Max(1, prod.Cantidad - 1))"
                                           Disabled="@(!prod.Seleccionado)">-</MudButton>
                                <MudButton Disabled="true" Style="min-width: 40px;">@prod.Cantidad</MudButton>
                                <MudButton OnClick="@(() => prod.Cantidad++)"
                                           Disabled="@(!prod.Seleccionado)">+</MudButton>
                            </MudButtonGroup>

                        </MudStack>
                    }
                </MudStack>
            }

            @* Botón cargar *@
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Inventory"
                       Disabled="@(lstHabitacionesSeleccionadas.Count == 0 || lstProductosSeleccionados.Count == 0)"
                       OnClick="AbrirModalCarga" Class="mt-2">
                Carga de Productos (@lstHabitacionesSeleccionadas.Count hab, @lstProductosSeleccionados.Count productos)
            </MudButton>

        </MudPaper>
    }
</MudContainer>

@code {
    [Inject] private HotelContext Context { get; set; }
    [Inject] private IDialogService DialogService { get; set; }
    [Inject] private ISnackbar Snackbar { get; set; }

    private bool Cargando = true;
    private List<CategoriaHabitacionDto> lstCategorias = new();
    private List<PaqueteDto> lstPaquetes = new();
    private List<HabitacionSeleccionDto> lstHabitacionesTodas = new();
    private List<HabitacionSeleccionDto> lstHabitacionesFiltradas = new();
    private List<ProductoCargaDto> lstProductos = new();
    private decimal categoriaSeleccionada;
    private decimal paqueteSeleccionado;
    private bool generarCodigos = true;
    private List<decimal> habitacionesSeleccionadas = new();

    private bool todasSeleccionadas
    {
        get => lstHabitacionesFiltradas.Count > 0 &&
               lstHabitacionesFiltradas.All(h => habitacionesSeleccionadas.Contains(h.ID_NroHab));
        set
        {
            if (value)
                habitacionesSeleccionadas = lstHabitacionesFiltradas.Select(h => h.ID_NroHab).ToList();
            else
                habitacionesSeleccionadas.Clear();
            StateHasChanged();
        }
    }

    private void OnHabitacionesChanged(IReadOnlyCollection<decimal> valores)
    {
        habitacionesSeleccionadas = valores?.ToList() ?? new();
        StateHasChanged();
    }

    private bool todosProductosMarcados
    {
        get => lstProductos.Count > 0 && lstProductos.All(p => p.Seleccionado);
        set
        {
            foreach (var p in lstProductos)
                p.Seleccionado = value;
        }
    }

    private List<HabitacionSeleccionDto> lstHabitacionesSeleccionadas =>
        lstHabitacionesFiltradas.Where(h => habitacionesSeleccionadas.Contains(h.ID_NroHab)).ToList();

    private List<ProductoCargaDto> lstProductosSeleccionados =>
        lstProductos.Where(p => p.Seleccionado && p.Cantidad > 0).ToList();

    protected override async Task OnInitializedAsync()
    {
        lstCategorias = await Context.CategoriaHabitaciones.AsNoTracking()
            .OrderBy(c => c.TipoHab)
            .Select(c => new CategoriaHabitacionDto
            {
                ID_Categoria = c.ID_Categoria,
                TipoHab = c.TipoHab
            })
            .ToListAsync();

        lstHabitacionesTodas = await Context.Habitaciones.AsNoTracking()
            .OrderBy(h => h.DescripcionHab)
            .Select(h => new HabitacionSeleccionDto
            {
                ID_NroHab = h.ID_NroHab,
                DescripcionHab = h.DescripcionHab,
                ID_CategoriasFK = h.ID_CategoriasFK
            })
            .ToListAsync();

        await CargarPaquetes();
        FiltrarHabitaciones();
        Cargando = false;
    }

    private async Task CargarPaquetes()
    {
        if (categoriaSeleccionada == 0m)
        {
            lstPaquetes.Clear();
            paqueteSeleccionado = 0m;
            await CargarProductosPaquete();
            return;
        }

        lstPaquetes = await Context.PaqueteProductos.AsNoTracking()
            .Where(p => p.ID_CategoriaHabitacionFK == categoriaSeleccionada)
            .OrderBy(p => p.Nombre)
            .Select(p => new PaqueteDto
            {
                ID_Paquete = p.ID_Paquete,
                Nombre = p.Nombre
            })
            .ToListAsync();

        if (lstPaquetes.Count == 0)
            paqueteSeleccionado = 0m;
        else if (!lstPaquetes.Any(p => p.ID_Paquete == paqueteSeleccionado))
            paqueteSeleccionado = lstPaquetes.First().ID_Paquete;

        await CargarProductosPaquete();
    }

    private async Task CargarProductosPaquete()
    {
        lstProductos = new();

        if (paqueteSeleccionado == 0m)
            return;

        var categoriaLookup = await Context.CategoriasProductos.AsNoTracking()
            .ToDictionaryAsync(c => c.ID_CategoriasPro, c => c.NombreCatProductos);
        var modeloLookup = await Context.Modelos.AsNoTracking()
            .ToDictionaryAsync(m => m.ID_Modelos, m => m.NombreModelos);

        lstProductos = await Context.PaqueteProductoDetalles.AsNoTracking()
            .Where(d => d.ID_PaqueteFK == paqueteSeleccionado)
            .Select(d => new ProductoCargaDto
            {
                ID_TipoProducto = d.ID_TipoProductoFK,
                Descripcion = d.TipoProducto.Nombre,
                DescripcionDetalle = d.TipoProducto.Descripcion ?? "",
                ID_CategoriaProFK = d.TipoProducto.ID_CategoriaProFK,
                ID_ModelosFK = d.TipoProducto.ID_ModelosFK,
                Cantidad = d.Cantidad,
                Seleccionado = true
            })
            .ToListAsync();

        foreach (var item in lstProductos)
        {
            item.Categoria = categoriaLookup.ContainsKey(item.ID_CategoriaProFK)
                ? categoriaLookup[item.ID_CategoriaProFK]
                : "";
            item.Modelo = modeloLookup.ContainsKey(item.ID_ModelosFK)
                ? modeloLookup[item.ID_ModelosFK]
                : "";
        }
    }

    private async Task OnCategoriaChanged()
    {
        paqueteSeleccionado = 0m;
        FiltrarHabitaciones();
        await CargarPaquetes();
        StateHasChanged();
    }

    private async Task OnPaqueteChanged()
    {
        await CargarProductosPaquete();
        StateHasChanged();
    }

    private void FiltrarHabitaciones()
    {
        habitacionesSeleccionadas = new();

        lstHabitacionesFiltradas = lstHabitacionesTodas
            .Where(h => h.ID_CategoriasFK == categoriaSeleccionada)
            .ToList();
    }

    private async Task AbrirAdministradorPaquetes()
    {
        if (lstPaquetes.Count == 0)
        {
            await AbrirEditarPaquete(0m, categoriaSeleccionada);
            return;
        }

        var options = new DialogOptions() { MaxWidth = MaxWidth.Medium, FullWidth = true };

        var parametros = new DialogParameters
        {
            { "Paquetes", lstPaquetes.Select(p => new PaqueteOpcionDto { ID_Paquete = p.ID_Paquete, Nombre = p.Nombre }).ToList() }
        };

        var dialog = DialogService.Show<SeleccionarPaqueteDialog>(
            "Administrar Paquetes",
            parametros,
            options);

        var result = await dialog.Result;
        if (result == null || result.Canceled || result.Data == null)
            return;

        var decision = (PaqueteOpcionDto)result.Data;
        if (decision.ID_Paquete == 0m)
        {
            await AbrirEditarPaquete(0m, categoriaSeleccionada);
        }
        else if (decision.Accion == "Editar")
        {
            await AbrirEditarPaquete(decision.ID_Paquete, categoriaSeleccionada);
        }
        else
        {
            paqueteSeleccionado = decision.ID_Paquete;
            await CargarProductosPaquete();
            StateHasChanged();
        }
    }

    private async Task AbrirEditarPaquete(decimal idPaquete, decimal categoriaHab)
    {
        var parameters = new DialogParameters
        {
            { "Modo", idPaquete > 0 ? "Editar" : "Insertar" },
            { "ID_Paquete", idPaquete },
            { "CategoriaHabitacionFK", categoriaHab }
        };

        var options = new DialogOptions() { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<D_Paquete>(
            (idPaquete > 0 ? "EDITAR" : "NUEVO") + " PAQUETE",
            parameters,
            options);

        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await CargarPaquetes();

            if (result.Data is decimal idGuardado)
            {
                paqueteSeleccionado = idGuardado;
                await CargarProductosPaquete();
            }

            StateHasChanged();
        }
    }

    private async Task AbrirModalCarga()
    {
        var parameters = new DialogParameters
        {
            { "Habitaciones", lstHabitacionesSeleccionadas },
            { "Productos", lstProductosSeleccionados },
            { "GenerarCodigos", generarCodigos },
            { "CategoriaHabitacion", lstCategorias.FirstOrDefault(c => c.ID_Categoria == categoriaSeleccionada) }
        };

        var options = new DialogOptions() { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<CargaProductosModal>(
            "Confirmar Carga",
            parameters,
            options);

        var result = await dialog.Result;
        if (!result.Canceled)
        {
            BlanquearVentana();
        }
    }

    private void BlanquearVentana()
    {
        categoriaSeleccionada = 0m;
        paqueteSeleccionado = 0m;
        lstPaquetes = new();
        lstProductos = new();
        lstHabitacionesFiltradas = new();
        habitacionesSeleccionadas = new();
        StateHasChanged();
    }

    public class CategoriaHabitacionDto
    {
        public decimal ID_Categoria { get; set; }
        public string TipoHab { get; set; } = "";
    }

    public class PaqueteDto
    {
        public decimal ID_Paquete { get; set; }
        public string Nombre { get; set; } = "";
    }

    public class HabitacionSeleccionDto
    {
        public decimal ID_NroHab { get; set; }
        public string DescripcionHab { get; set; } = "";
        public decimal ID_CategoriasFK { get; set; }
    }

    public class ProductoCargaDto
    {
        public decimal ID_TipoProducto { get; set; }
        public string Descripcion { get; set; } = "";
        public string DescripcionDetalle { get; set; } = "";
        public string Categoria { get; set; } = "";
        public string Modelo { get; set; } = "";
        public decimal ID_CategoriaProFK { get; set; }
        public decimal ID_ModelosFK { get; set; }
        public bool Seleccionado { get; set; }
        public int Cantidad { get; set; }
    }

    public class PaqueteOpcionDto
    {
        public decimal ID_Paquete { get; set; }
        public string Nombre { get; set; } = "";
        public string Accion { get; set; } = "";
    }
}