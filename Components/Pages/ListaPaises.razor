@page "/listapaises"
@attribute [Authorize(Policy = "ManageConfiguraciones")]
@using Microsoft.EntityFrameworkCore
@inject HotelContext Context
@inject IDialogService DialogService

<ValidaPermiso PermisoRequerido="ManageConfiguraciones" Objeto="ListaPaises" />

<MudContainer>
    <MudText Typo="Typo.h4" Class="mb-4">Países</MudText>
    <MudPaper Elevation="4" Class="pa-4">
        @if (Cargando)
        {
            <MudStack AlignItems="AlignItems.Center" Class="py-8">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            </MudStack>
        }
        else
        {
            <MudTable Items="@lstPaises" Dense="true" Hover="true" Striped="true" FixedHeader="true"
                      Breakpoint="Breakpoint.Md" Filter="new Func<Pais,bool>(FilterFunc1)"
                      @bind-SelectedItem="selectedItem">
                <ToolBarContent>
                    <MudTextField @bind-Value="searchString" Placeholder="Buscar" Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Style="width:300px;" />
                    <MudSpacer />
                    <MudFab Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                            OnClick="@(() => AccionItem("Insertar", 0))" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Acciones</MudTh>
                    <MudTh>Nombre</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Acciones">
                        <MudTooltip Text="Ver">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Info" Color="Color.Info"
                                           OnClick="@(() => AccionItem("Ver", context.ID_PaisOrigen))" />
                        </MudTooltip>
                        <MudTooltip Text="Editar">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Success"
                                           OnClick="@(() => AccionItem("Editar", context.ID_PaisOrigen))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                           OnClick="@(() => AccionItem("Eliminar", context.ID_PaisOrigen))" />
                        </MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="Nombre">@context.NombrePais</MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager RowsPerPageString="Filas por Página."
                                   InfoFormat="Filas {first_item}-{last_item} de {all_items}"
                                   PageSizeOptions="new int[] { 25, 50, 100 }" />
                </PagerContent>
            </MudTable>
        }
    </MudPaper>
</MudContainer>

@code {
    private string searchString = "";
    private bool Cargando = true;
    private List<Pais> lstPaises = new();
    private Pais selectedItem = null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarDatos();
            Cargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarDatos()
    {
        lstPaises = await Context.Paises.AsNoTracking().OrderBy(p => p.NombrePais).ToListAsync();
    }

    private bool FilterFunc1(Pais element) => FilterFunc(element, searchString);

    private bool FilterFunc(Pais element, string search)
    {
        if (string.IsNullOrWhiteSpace(search)) return true;
        if (element.NombrePais.Contains(search, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private async Task AccionItem(string modo, decimal id)
    {
        var parameters = new DialogParameters { { "Modo", modo }, { "ID", id } };
        var dialog = await DialogService.ShowAsync<D_Pais>(modo.ToUpper() + " PAÍS", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            Cargando = true;
            StateHasChanged();
            await CargarDatos();
            Cargando = false;
            StateHasChanged();
        }
    }
}
