@page "/listarazonsocial"
@attribute [Authorize(Policy = "ManageProveedores")]

@using Microsoft.EntityFrameworkCore

<ValidaPermiso PermisoRequerido="ManageProveedores" Objeto="ListaRazonSocial" />

<MudContainer>
    <MudText Typo="Typo.h4">Listado de Razones Sociales</MudText>
    <MudPaper Class="d-flex justify-content-center p-4" Width="100%">
        <MudPaper Style="width:80rem;">
            @if (Cargando)
            {
                <MudGrid Style="text-align:center;">
                    <MudItem sm="12">
                        <MudText Typo="Typo.h6">Cargando registros...</MudText>
                        <MudProgressCircular Color="Color.Primary" Style="height:70px;width:70px;" Indeterminate="true" />
                    </MudItem>
                </MudGrid>
            }
            else
            {
                <MudTable Items="@lstRazonSocial" Breakpoint="Breakpoint.Md" Style="width:100%;padding:1rem; margin:auto;" Dense="true" Hover="true" Striped="true" @ref="table" FixedHeader="true" Filter="new Func<RazonSocialListDto,bool>(FilterFunc1)">
                    <ToolBarContent>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" Style="width:100%;">
                            <MudTextField T="string" @bind-Value="searchString" Style="width:300px;" Placeholder="Buscar..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
                            <MudTooltip Text="Agregar Razón Social">
                                <MudFab Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" Color="Color.Success" OnClick="@(() => AccionRazonSocial(maxWidth, "Insertar", 0))" />
                            </MudTooltip>
                        </MudStack>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>Acciones</MudTh>
                        <MudTh Style="text-align:left;">Nombre</MudTh>
                        <MudTh Style="text-align:left;">CUIL</MudTh>
                        <MudTh Style="text-align:left;">Dirección Física</MudTh>
                        <MudTh Style="text-align:left;">Teléfono Celular</MudTh>
                        <MudTh Style="text-align:left;">Email</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Class="d-inline-flex justify-center">
                            <MudTooltip Text="Ver Razón Social">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Search" Color="Color.Info" OnClick="@((e) => AccionRazonSocial(maxWidth, "Ver", @context.ID_RazonSocial))" />
                            </MudTooltip>
                            <MudTooltip Text="Editar Razón Social">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Success" OnClick="@((e) => AccionRazonSocial(maxWidth, "Editar", @context.ID_RazonSocial))" />
                            </MudTooltip>
                            <MudTooltip Text="Eliminar Razón Social">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@((e) => AccionRazonSocial(maxWidth, "Eliminar", @context.ID_RazonSocial))" />
                            </MudTooltip>
                        </MudTd>
                        <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
                        <MudTd DataLabel="CUIL">@context.Cuil</MudTd>
                        <MudTd DataLabel="DireccionFisica">@context.DireccionFisica</MudTd>
                        <MudTd DataLabel="Telefono">@context.TelefonoCelular</MudTd>
                        <MudTd DataLabel="Email">@context.Email</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager RowsPerPageString="Filas por Pagina." InfoFormat="@($"Filas {infoFormat}")" HorizontalAlignment="HorizontalAlignment.Center" PageSizeOptions="new int[] { 25, 50, 100 }" />
                    </PagerContent>
                </MudTable>
            }
        </MudPaper>
    </MudPaper>
</MudContainer>

@code {
    private MudTable<RazonSocialListDto> table;
    private string searchString = "";
    private string infoFormat = "{first_item}-{last_item} de {all_items}";
    private bool Cargando = true;

    private List<RazonSocialListDto> lstRazonSocial = new();

    [Inject] private HotelContext Context { get; set; }
    [Inject] private IDialogService DialogService { get; set; }

    private DialogOptions maxWidth = new DialogOptions() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarDatos();
            Cargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarDatos()
    {
        lstRazonSocial = await Context.RazonSociales.AsNoTracking()
            .OrderBy(r => r.Nombre)
            .Select(r => new RazonSocialListDto
            {
                ID_RazonSocial = r.ID_RazonSocial,
                Nombre = r.Nombre,
                Cuil = r.Cuil,
                DireccionFisica = r.DireccionFisica,
                DireccionDigital = r.DireccionDigital,
                TelefonoFijo = r.TelefonoFijo,
                TelefonoCelular = r.TelefonoCelular,
                Email = r.Email
            })
            .ToListAsync();
    }

    private bool FilterFunc1(RazonSocialListDto element) => FilterFunc(element, searchString);

    private bool FilterFunc(RazonSocialListDto element, string search)
    {
        if (string.IsNullOrWhiteSpace(search))
            return true;
        if (element.Nombre.Contains(search, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.DireccionFisica.Contains(search, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    private async Task AccionRazonSocial(DialogOptions options, string modo, decimal id)
    {
        var parameters = new DialogParameters
        {
            { "Modo", modo },
            { "ID", id }
        };
        var dialog = DialogService.Show<D_RazonSocial>(modo.ToUpper() + " RAZÓN SOCIAL", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await CargarDatos();
            StateHasChanged();
        }
    }

    public class RazonSocialListDto
    {
        public decimal ID_RazonSocial { get; set; }
        public string Nombre { get; set; } = "";
        public decimal Cuil { get; set; }
        public string DireccionFisica { get; set; } = "";
        public string DireccionDigital { get; set; } = "";
        public string TelefonoFijo { get; set; } = "";
        public string TelefonoCelular { get; set; } = "";
        public string Email { get; set; } = "";
    }
}