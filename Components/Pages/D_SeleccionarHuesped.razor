@using Microsoft.EntityFrameworkCore
@inject HotelContext Context
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="10">
                <MudTextField @bind-Value="busquedaHuesped" Placeholder="Nombre, apellido..."
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium" Variant="Variant.Outlined" Margin="Margin.Dense"
                              TextChanged="OnBuscarChanged" />
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-center justify-center">
                <MudButton Variant="Variant.Filled" Color="Color.Info" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirCrearHuesped">
                    Nuevo
                </MudButton>
            </MudItem>
            <MudItem xs="12" md="12">
                @if (Cargando)
                {
                    <MudStack AlignItems="AlignItems.Center" Class="py-4">
                        <MudProgressCircular Color="Color.Primary" Size="Size.Medium" Indeterminate="true" />
                    </MudStack>
                }
                else
                {
                    <MudTable Items="@lstHuespedesFiltrados" Dense="true" Hover="true" Striped="true"
                              Breakpoint="Breakpoint.Md" Height="350px" FixedHeader="true" RowsPerPage="10">
                        <HeaderContent>
                            <MudTh>Seleccionar</MudTh>
                            <MudTh>Nombre</MudTh>
                            <MudTh>Apellido</MudTh>
                            <MudTh>Ingreso</MudTh>
                            <MudTh>Salida</MudTh>
                            <MudTh>Días</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Seleccionar">
                                <MudRadio T="decimal" Value="@context.ID_Huesped" Color="Color.Success"
                                           OnClick="@(() => SeleccionarHuesped(context.ID_Huesped))" />
                            </MudTd>
                            <MudTd DataLabel="Nombre">@context.Nombre?.Trim()</MudTd>
                            <MudTd DataLabel="Apellido">@context.Apellido?.Trim()</MudTd>
                            <MudTd DataLabel="Ingreso">@context.FechaIn.ToString("dd/MM/yyyy")</MudTd>
                            <MudTd DataLabel="Salida">@(context.FechaOut?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
                            <MudTd DataLabel="Días">@context.DiasAlojados</MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager RowsPerPageString="Filas por página."
                                           InfoFormat="Filas {first_item}-{last_item} de {all_items}" />
                        </PagerContent>
                    </MudTable>
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Color="Color.Error" Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Cancel">Cancelar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public decimal? HuespedIdActual { get; set; }

    private bool Cargando = true;
    private string busquedaHuesped = "";
    private List<Huesped> lstHuespedes = new();
    private List<Huesped> lstHuespedesFiltrados = new();
    private decimal huespedSeleccionadoId = 0;

    protected override async Task OnInitializedAsync()
    {
        if (HuespedIdActual.HasValue && HuespedIdActual > 0)
            huespedSeleccionadoId = HuespedIdActual.Value;

        await CargarHuespedes();
    }

    private async Task CargarHuespedes()
    {
        Cargando = true;
        lstHuespedes = await Context.Huespedes.AsNoTracking().ToListAsync();
        Filtrar();
        Cargando = false;
        StateHasChanged();
    }

    private void OnBuscarChanged(string valor)
    {
        busquedaHuesped = valor;
        Filtrar();
        StateHasChanged();
    }

    private async Task SeleccionarHuesped(decimal id)
    {
        var huesped = lstHuespedes.FirstOrDefault(h => h.ID_Huesped == id);
        if (huesped != null)
        {
            MudDialog.Close(DialogResult.Ok(huesped));
        }
    }

    private void Filtrar()
    {
        if (!string.IsNullOrWhiteSpace(busquedaHuesped))
        {
            var busq = busquedaHuesped.Trim().ToLower();
            lstHuespedesFiltrados = lstHuespedes.Where(h =>
                (h.Nombre != null && h.Nombre.ToLower().Contains(busq)) ||
                (h.Apellido != null && h.Apellido.ToLower().Contains(busq))
            ).ToList();
        }
        else
        {
            lstHuespedesFiltrados = lstHuespedes.ToList();
        }
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task AbrirCrearHuesped()
    {
        var dialog = await DialogService.ShowAsync<D_CrearHuesped>("NUEVO HUÉSPED",
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is Huesped huespedCreado)
        {
            huespedSeleccionadoId = huespedCreado.ID_Huesped;
            await CargarHuespedes();
        }
    }
}
