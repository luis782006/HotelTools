@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

@inject IJSRuntime js;
@inject IConfiguration configuration;
@inject NavigationManager nav;
@inject BrowserJS browserJS;
@inject AuthServices authService;
@inject CustomAuthenticationStateProvider authStateProvider;

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Fixed="true">
   
        
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h5" Class="ml-3">Hotel Tools</MudText>
        <MudSpacer />
             <AuthorizeView>
                <Authorized> 
                    <div>
                       
                        <MudIconButton style="color:white;" Icon="@Icons.Material.Filled.Logout" @onclick="Logout" />
                    </div>
                 </Authorized>
                <NotAuthorized> 
                    <div>
                  
                    <MudIconButton style="color:white;" Icon="@Icons.Material.Filled.Login" @onclick="LogIn" />
                    </div>
                 </NotAuthorized>
            </AuthorizeView>
       
    
     </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }

    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    MudTheme _theme = new MudTheme();
    string Token { get; set; } = string.Empty;

    bool hasSession = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await authStateProvider.GetAuthenticationStateFromCookieAsync();
            StateHasChanged();
        }
    }

   
    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private MudTheme CreateTheme()
    {
        return new MudTheme
            {

                PaletteDark = new PaletteDark
                {
                    Primary = Colors.Blue.Lighten5,
                    Secondary = Colors.Blue.Lighten4,
                    AppbarBackground = Colors.Blue.Lighten1

                }
            };

    }

    



    private async void Logout()
    {
        var cookieName = configuration["Util:CookieName"];
        var token = await browserJS.GetCookie(cookieName);
        
        if (!string.IsNullOrEmpty(token))
        {
            await authService.Logout(token);
        }
        
        nav.NavigateTo("/login", true);
    }

    private void LogIn()
    {
        nav.NavigateTo("/login", true);
    }
}