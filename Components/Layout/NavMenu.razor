@using Microsoft.AspNetCore.Components.Authorization
<MudAppBar Elevation="0" Color="Color.Dark">
    <MudText Typo="Typo.h6" Class="ml-3">HotelTools</MudText>
</MudAppBar>
<MudPaper Width="250px" Class="py-3" Elevation="0">    
    <MudNavMenu>
        <MudText Typo="Typo.h6" Class="px-4">Modulos</MudText>
        <MudText Typo="Typo.body2" Class="px-4 mud-text-secondary">Administración de Módulos</MudText>
        <MudDivider Class="my-2" />

        <MudNavGroup Title="Inventarios" Icon="@Icons.Material.Filled.Inventory" Expanded="false">
            <MudNavLink Href="/panelhabitaciones">Panel de Habitaciones</MudNavLink>
            <MudNavLink Href="/">Control Habitacional</MudNavLink>
        </MudNavGroup>
        <RequierePermiso PermisoRequerido="ViewQuejas">
            <MudNavGroup Title="Quejas" Icon="@Icons.Material.Filled.AddModerator" Expanded="false">
                <MudNavLink Href="/">Quejas</MudNavLink>          
            </MudNavGroup>
        </RequierePermiso>
    </MudNavMenu>
</MudPaper>
    <RequierePermiso PermisoRequerido="ManageConfiguraciones">
        <MudPaper Width="250px" Class="mt-auto" Elevation="0">
            <MudNavMenu Color="Color.Info" Rounded="true" Margin="Margin.Dense" Class="m-3 p-1">
                <MudText Typo="Typo.h6" Class="px-4">Configuraciones</MudText>
                <MudText Typo="Typo.body2" Class="px-4 mud-text-secondary">Panel Admin</MudText>
                <MudDivider Class="my-2" />
                <MudNavGroup Title="Configuraciones Globales" Icon="@Icons.Material.Filled.Settings" Expanded="false">
                    <MudNavLink Href="/cargamasivahabitaciones">Carga Masiva Habitaciones</MudNavLink>
                    <MudNavLink Href="/cargaproductos">Carga de Productos</MudNavLink>
                    <MudNavLink Href="/listadepartamentos">Departamentos</MudNavLink>
                    <MudNavLink Href="/listacategoriahabitaciones">Categoria Habitaciones</MudNavLink>
                    <MudNavGroup Title="Usuarios" Icon="@Icons.Material.Filled.Person" Expanded="false">
                        <MudNavLink Href="/listausuarios">Listado de Usuarios</MudNavLink>
                        <MudNavLink Href="/registrousuarios">Crear Usuario</MudNavLink>
                        <MudNavLink Href="/registroles">Listado de Roles</MudNavLink>
                        <MudNavLink Href="/listapermisos">Listado de Permisos</MudNavLink>
                    </MudNavGroup>
                </MudNavGroup>
                <RequierePermiso PermisoRequerido="ManageInventario">
                    <MudNavGroup Title="Inventario" Icon="@Icons.Material.Filled.SettingsApplications" Expanded="false">
                    <MudNavLink Href="/listamodelos">Modelos</MudNavLink>
                    <MudNavLink Href="/listaproductos">Productos</MudNavLink>            
                    <MudNavLink Href="/listacategoriaproductos">Categoria Productos</MudNavLink>
                </MudNavGroup>
                </RequierePermiso>
                <RequierePermiso PermisoRequerido="ManageProveedores">
                    <MudNavGroup Title="Proveedores" Icon="@Icons.Material.Filled.SupervisedUserCircle" Expanded="false">
                        <MudNavLink Href="/listaproveedores">Registros de Proveedores</MudNavLink>
                        <MudNavLink Href="/listarazonsocial">Razón Social</MudNavLink>
                        <MudNavLink Href="/listarepresentantes">Representantes</MudNavLink>
                    </MudNavGroup>
                </RequierePermiso>
                <MudDivider Class="my-2"/>
                <MudNavLink Href="/about">About</MudNavLink>
            </MudNavMenu>
        </MudPaper>
    </RequierePermiso>

